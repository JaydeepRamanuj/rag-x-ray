# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=          # optional

# Database (Neon): pooled for the app, direct for migrations.
# If DATABASE_URL_UNPOOLED is empty, drizzle.config.ts derives it by
# dropping "-pooler" from the pooled host.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Simple guard for upload and eval routes
APP_PASSWORD=
